{
  "version": 6,
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Dev (Clang + vcpkg)",
      "description": "Development preset using Clang and vcpkg",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "/home/subham/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "displayName": "Dev Build",
      "configurePreset": "dev"
    }
  ]
}
